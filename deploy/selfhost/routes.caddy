# The route table: which container answers which path. Imported by both front doors — Caddyfile
# (owns TLS) and Caddyfile.external-tls (behind a terminator that does) — so the paths exist once.

# NO path stripping: the API canonicalizes one leading `/api` off itself, so `/api/sync` here and
# `/sync` from a native client hash identically for idempotency. A strip would double-strip
# `/api/api/…`. `/internal/*` is the shared-secret alert intake an operator's monitor calls — 404
# until TF_ALERT_SECRET arms it, and nothing in the product's own UI ever uses it.
@api path /api /api/* /auth /auth/* /events /health /hello /pair /pair/* /internal /internal/*
handle @api {
	reverse_proxy api:8080
}

# The staging bucket's browser door. Uploads are presigned against THIS origin, so the path carries
# the bucket name (track S3_BUCKET) and the Host must stay as sent — SigV4 signs it, and MinIO
# recomputes over what it receives. Safe only because the bucket is PRIVATE: unsigned requests 403.
# Never attach an anonymous policy; the boot check probes an unsigned GET and PUT.
@staging path /{$S3_BUCKET:ohmail-staging}/*
handle @staging {
	reverse_proxy minio:9000
}

# Everything else is the web application.
handle {
	reverse_proxy web:3000
}

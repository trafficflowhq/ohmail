# The front door that owns TLS. The site address IS the configuration: OHMAIL_ORIGIN, from
# docker-compose.yml. Routes are in routes.caddy, which both doors import. For a stack behind a
# terminator that owns the certificate, set OHMAIL_EXTERNAL_TLS=1 and entrypoint.sh runs
# Caddyfile.external-tls instead. Origin forms and the private-name recipe: docs/self-host/VPS.md.
{$OHMAIL_ORIGIN} {
	# `tls internal` or nothing — compose maps the operator's boolean to exactly one of those, so
	# no Caddy configuration is reachable from `.env`. Required for any private name: Caddy picks
	# its internal issuer only for `localhost` and bare IPs, so `ohmail.test` otherwise goes to
	# ACME, which cannot issue for it and retries for thirty days.
	{$OHMAIL_TLS_DIRECTIVE:}

	# HTTPS from here on: never dial this host in the clear again. Two years, and neither
	# `includeSubDomains` nor `preload` — both reach names this file cannot vouch for, and on
	# an apex origin the first would take every OTHER subdomain with it for the whole max-age.
	# Append `; includeSubDomains` yourself if you own every name under your origin. The header
	# belongs on this site and nowhere else: not the plain-HTTP door below, not
	# Caddyfile.external-tls, not routes.caddy, which both doors import.
	#
	# The placeholder below is empty unless OHMAIL_TLS_INTERNAL is set, where it removes the
	# header again (docker-compose.yml says why). It must stay ABOVE the set, and the set must
	# stay DEFERRED: deferred header handlers apply outermost-last, and an undeferred set still
	# stamped a 502 raised before the write — an HSTS entry stored against a private CA.
	{$OHMAIL_HSTS_DIRECTIVE:}
	header {
		defer
		Strict-Transport-Security "max-age=63072000"
	}

	import /etc/caddy/routes.caddy
}

# EVERY OTHER ADDRESS THIS BOX IS DIALLED AT — its IP, a `127.0.0.1` health check, a LAN name.
# The site above matches on the ORIGIN'S HOST, and Caddy's answer to a Host that matches no site
# at all is a bare 200 with an empty body: a monitor, and this project's own release check, read
# that as a healthy install serving nothing. So this door says what it is instead — the build
# token, proxied from the web container so there is one truth about it, and a 421 (the request
# reached the wrong authority) naming the real origin for everything else. NO product route is
# reachable here: `{$OHMAIL_ORIGIN}` stays the only door into the application. The 421 is one
# page with its style inline: nothing to fetch, nothing to press, and nothing of the request in
# it; the origin is the only value, substituted when Caddy reads this file (entrypoint.sh admits
# only an origin's characters). The page is one backtick-quoted token, not a heredoc: a heredoc ends
# wherever the text read so far ends in its marker, and the gate admits no backtick, so no origin
# can end this one.
#
# The port is the one the site above listens on: 80 in every install, the whole reason this
# compose publishes 80 and 443. A development overlay that moves the front door elsewhere sets
# OHMAIL_FRONT_DOOR_PORT to the port it moved it to, or this door listens where nothing calls.
http://:{$OHMAIL_FRONT_DOOR_PORT:80} {
	# Held across a web swap for reads, as in routes.caddy, so a monitor reads no 502 mid-upgrade.
	@replayable method GET HEAD OPTIONS
	handle /version {
		reverse_proxy @replayable web:3000 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
		reverse_proxy web:3000
	}
	handle {
		header Content-Type "text/html; charset=utf-8"
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		header X-Content-Type-Options nosniff
		header Cache-Control no-store
		respond `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>This server answers at another address</title>
<style>
:root{color-scheme:light dark}
@media (prefers-color-scheme:dark){
.g{background:#0E0D0C !important}
.s{background:#23201C !important}
.i{color:#F6F1E9 !important}
.j{color:#B8AFA3 !important}
}
</style>
</head>
<body class="g" style="margin:0;padding:48px 16px;background:#F0EBE3;font:400 17px/27px Arial,Helvetica,sans-serif;">
<main class="s" style="display:block;max-width:536px;margin:0 auto;padding:32px;background:#FFFFFF;border-radius:20px;">
<h1 class="i" style="margin:0 0 16px;font:900 28px/32px 'Arial Black',Arial,Helvetica,sans-serif;color:#12100E;letter-spacing:-0.02em;">This server answers at another address.</h1>
<p class="i" style="margin:0 0 14px;font-weight:700;color:#12100E;overflow-wrap:anywhere;">Open it at {$OHMAIL_ORIGIN}.</p>
<p class="j" style="margin:0;color:#5A534B;">It was reached by its number or by another name, and it only answers at the one address it was set up with.</p>
</main>
</body>
</html>` 421
	}
}

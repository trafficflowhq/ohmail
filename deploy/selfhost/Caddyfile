# The front door that owns TLS. The site address IS the configuration: OHMAIL_ORIGIN, from
# docker-compose.yml. Routes are in routes.caddy, which both doors import. For a stack behind a
# terminator that owns the certificate, set OHMAIL_EXTERNAL_TLS=1 and compose mounts
# Caddyfile.external-tls instead. Origin forms and the private-name recipe: docs/self-host/VPS.md.
{$OHMAIL_ORIGIN} {
	# `tls internal` or nothing — compose maps the operator's boolean to exactly one of those, so
	# no Caddy configuration is reachable from `.env`. Required for any private name: Caddy picks
	# its internal issuer only for `localhost` and bare IPs, so `ohmail.test` otherwise goes to
	# ACME, which cannot issue for it and retries for thirty days.
	{$OHMAIL_TLS_DIRECTIVE:}

	import /etc/caddy/routes.caddy
}

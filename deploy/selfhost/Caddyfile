# The front door that owns TLS. The site address IS the configuration: OHMAIL_ORIGIN, from
# docker-compose.yml. Routes are in routes.caddy, which both doors import. For a stack behind a
# terminator that owns the certificate, set OHMAIL_EXTERNAL_TLS=1 and compose mounts
# Caddyfile.external-tls instead. Origin forms and the private-name recipe: docs/self-host/VPS.md.
{$OHMAIL_ORIGIN} {
	# `tls internal` or nothing — compose maps the operator's boolean to exactly one of those, so
	# no Caddy configuration is reachable from `.env`. Required for any private name: Caddy picks
	# its internal issuer only for `localhost` and bare IPs, so `ohmail.test` otherwise goes to
	# ACME, which cannot issue for it and retries for thirty days.
	{$OHMAIL_TLS_DIRECTIVE:}

	import /etc/caddy/routes.caddy
}

# EVERY OTHER ADDRESS THIS BOX IS DIALLED AT — its IP, a `127.0.0.1` health check, a LAN name.
# The site above matches on the ORIGIN'S HOST, and Caddy's answer to a Host that matches no site
# at all is a bare 200 with an empty body: a monitor, and this project's own release check, read
# that as a healthy install serving nothing. So this door says what it is instead — the build
# token, proxied from the web container so there is one truth about it, and a 421 (the request
# reached the wrong authority) naming the real origin for everything else. NO product route is
# reachable here: `{$OHMAIL_ORIGIN}` stays the only door into the application.
#
# The port is the one the site above listens on: 80 in every install, the whole reason this
# compose publishes 80 and 443. A development overlay that moves the front door elsewhere sets
# OHMAIL_FRONT_DOOR_PORT to the port it moved it to, or this door listens where nothing calls.
http://:{$OHMAIL_FRONT_DOOR_PORT:80} {
	handle /version {
		reverse_proxy web:3000
	}
	handle {
		respond "This install answers at {$OHMAIL_ORIGIN}" 421
	}
}

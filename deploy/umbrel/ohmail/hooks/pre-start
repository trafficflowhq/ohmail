#!/usr/bin/env bash
# umbrelOS pre-start hook for the ohmail app. Runs on the device before every
# `docker compose up` of this app.
#
# umbrelOS apps have no install-time configuration screen, so this hook is where the
# stack's configuration comes from:
#
#   · SECRETS are generated here, once, and kept in data/env/secrets.env — the database
#     password, the key that encrypts mailbox credentials at rest (TF_KEK_V1), and the
#     staging-store credential. The person installing never handles them. They are
#     random, not derived from the device seed, ON PURPOSE: TF_KEK_V1 is the one value
#     worth copying into a password manager, because with it (plus a database dump) the
#     install can be rebuilt on ANY machine — losing the device must not mean losing the
#     key. A seed-derived key would be exactly as safe on the device and strictly worse
#     off it.
#   · The PER-SERVICE env files the compose reads (data/env/{db,api,organizer,minio}.env)
#     are DERIVED from secrets.env on every start, so the api and the organizer can never
#     disagree about the key ring or the storage block — the same reasoning as the
#     deliberate duplication in deploy/selfhost/docker-compose.yml, produced here by one
#     writer instead.
#   · data/env/settings.env is seeded once with the values only the operator can know —
#     OHMAIL_ORIGIN above all — and is theirs to edit. It is listed AFTER the generated
#     file in the compose's env_file order, so operator settings win.
#   · The CADDYFILE is rendered on every start from settings.env. Unconfigured, the
#     launcher site (the one Umbrel's app proxy opens) serves the setup steps instead of
#     a dead redirect; configured, it redirects to the real https origin and the TLS
#     site comes up. Rendering here rather than committing the file also means the front
#     door updates with the package — umbrelOS copies hooks on app updates, but not
#     files under data/.
#
# Nothing here talks to the network and nothing prints a secret.

set -euo pipefail

APP_DIR="${APP_DATA_DIR:-$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")}"
DATA_DIR="${APP_DIR}/data"
ENV_DIR="${DATA_DIR}/env"
SECRETS="${ENV_DIR}/secrets.env"
SETTINGS="${ENV_DIR}/settings.env"

# Container hostnames, in Umbrel's <app-id>_<service>_1 convention.
DB_HOST="ohmail_db_1"
MINIO_HOST="ohmail_minio_1"
MAILPIT_HOST="ohmail_mailpit_1"

mkdir -p "${ENV_DIR}" \
         "${DATA_DIR}/postgres" \
         "${DATA_DIR}/minio" \
         "${DATA_DIR}/caddy/state" \
         "${DATA_DIR}/caddy/config"

rand_hex() {
  # $1 bytes of randomness, as lowercase hex. openssl when present, /dev/urandom
  # otherwise — both exist on umbrelOS, the fallback is for safety.
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex "$1"
  else
    head -c "$1" /dev/urandom | od -An -v -tx1 | tr -d ' \n'
  fi
}

# ── secrets: generated once, never regenerated ─────────────────────────────────────
if [[ ! -f "${SECRETS}" ]]; then
  umask 077
  cat > "${SECRETS}" <<EOF
# Generated by the ohmail app on first start. Do not edit casually.
#
# TF_KEK_V1 encrypts mailbox credentials at rest — copy this file (or at least that
# line) into a password manager. To ROTATE the key, add TF_KEK_V2 with a fresh value
# to settings.env and KEEP TF_KEK_V1: new writes use the highest version, old rows
# still decrypt. Never replace TF_KEK_V1 in place — rows encrypted under it would
# become unreadable.
POSTGRES_PASSWORD=$(rand_hex 24)
TF_KEK_V1=$(rand_hex 32)
MINIO_ROOT_PASSWORD=$(rand_hex 24)
EOF
fi

# shellcheck disable=SC1090
source "${SECRETS}"

# ── per-service env files: derived on every start ──────────────────────────────────
umask 077

# Higher key-ring versions pass through when a rotation added them to secrets.env.
ring_lines() {
  echo "TF_KEK_V1=${TF_KEK_V1}"
  [[ -n "${TF_KEK_V2:-}" ]] && echo "TF_KEK_V2=${TF_KEK_V2}"
  [[ -n "${TF_KEK_V3:-}" ]] && echo "TF_KEK_V3=${TF_KEK_V3}"
  return 0
}

storage_lines() {
  cat <<EOF
TF_STORAGE_KIND=s3
S3_ENDPOINT=http://${MINIO_HOST}:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ohmail-staging
S3_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
S3_BUCKET=ohmail-staging
EOF
}

cat > "${ENV_DIR}/db.env" <<EOF
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
EOF

cat > "${ENV_DIR}/api.env" <<EOF
DATABASE_URL=postgres://ohmail:${POSTGRES_PASSWORD}@${DB_HOST}:5432/ohmail
$(ring_lines)
$(storage_lines)
SMTP_URL=smtp://${MAILPIT_HOST}:1025
MAIL_FROM=ohmail@selfhost.example
EOF

# The organizer reads DATABASE_URL_SESSION (not DATABASE_URL) and carries the SAME
# ring and storage block as the api — it is the only process that deletes staged
# attachment objects, and a mismatched block would grow the bucket without bound.
cat > "${ENV_DIR}/organizer.env" <<EOF
DATABASE_URL_SESSION=postgres://ohmail:${POSTGRES_PASSWORD}@${DB_HOST}:5432/ohmail
$(ring_lines)
$(storage_lines)
EOF

cat > "${ENV_DIR}/minio.env" <<EOF
MINIO_ROOT_USER=ohmail-staging
MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD}
EOF

# ── settings: seeded once, the operator's file from then on ────────────────────────
if [[ ! -f "${SETTINGS}" ]]; then
  cat > "${SETTINGS}" <<'EOF'
# ohmail settings. Set the one required value, then restart the ohmail app from the
# Umbrel dashboard. Everything commented out is optional and off by default.

# REQUIRED — the one browser address this install serves, scheme + host only, e.g.
#   OHMAIL_ORIGIN=https://mail.example.com
# The domain must resolve to your home and your router must forward outside port 443
# to this device's port 4443. This value derives the cookie host and the passkey
# identity; changing it later signs everybody out.
OHMAIL_ORIGIN=

# Outbound product mail (address verification, new-device notices). Unset, it lands
# in a local sink on the device instead of being delivered. Both lines or neither:
#SMTP_URL=smtps://user:password@smtp.example.com:465
#MAIL_FROM=ohmail@yourdomain.example
#MAIL_REPLY_TO=

# AI features (screening suggestions, reply drafting). You supply the key, you pay
# the model bill. Unset, those surfaces answer as unconfigured; everything else works.
#ANTHROPIC_API_KEY=

# Set to exactly 1 when a mailbox you want to connect lives on your own network (a
# private address). The add-mailbox connection check refuses private targets otherwise.
#TF_PROBE_ALLOW_PRIVATE=

# Set to exactly 1 when your phone's UnifiedPush distributor lives on your own network
# (an ntfy on this device, say). A separate switch from TF_PROBE_ALLOW_PRIVATE on
# purpose: permitting one connection check is not the same decision as permitting a
# background process to keep sending wakes.
#TF_PUSH_ALLOW_PRIVATE=

# Microsoft 365 / Exchange Online mailboxes need an app registration on the Microsoft
# side; password/IMAP mailboxes need none of this. Register
#   <your OHMAIL_ORIGIN>/api/mailboxes/oauth/microsoft/callback
# as the redirect URI, and set all FOUR lines — including MS_OAUTH_REDIRECT_URI, with
# exactly that value.
#MS_OAUTH_CLIENT_ID=
#MS_OAUTH_CLIENT_SECRET=
#MS_OAUTH_TENANT=
#MS_OAUTH_REDIRECT_URI=
EOF
fi

# ── the front door: rendered on every start from settings.env ──────────────────────
# Values are read with sed, not sourced — settings.env is the operator's file and this
# hook must not execute it. The origin is validated to a strict shape before it is
# baked into Caddy config: scheme https, then hostname (dots, dashes) and an optional
# port, nothing else. Anything that does not match renders the setup page instead.
setting() {
  sed -n "s/^$1=//p" "${SETTINGS}" 2>/dev/null | tail -n1 | tr -d '\r' \
    | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//" -e 's:/*$::'
}

ORIGIN="$(setting OHMAIL_ORIGIN)"
if ! [[ "${ORIGIN}" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?$ ]]; then
  ORIGIN=""
fi

# The staging bucket's name must match what the api and organizer read; the browser
# upload route below carries `/<bucket>/*`. An override that is not a valid bucket
# name falls back to the default rather than producing broken Caddy config.
BUCKET="$(setting S3_BUCKET)"
if ! [[ "${BUCKET}" =~ ^[a-z0-9][a-z0-9.-]{2,62}$ ]]; then
  BUCKET="ohmail-staging"
fi

CADDYFILE="${DATA_DIR}/caddy/Caddyfile"

if [[ -n "${ORIGIN}" ]]; then
  cat > "${CADDYFILE}" <<EOF
# Rendered by hooks/pre-start — do not edit; change data/env/settings.env instead.
#
# Same origin split as deploy/selfhost/Caddyfile — the API's path surface to the api
# container, everything else to the web container. Only host port 4443 is published on
# the device (umbrelOS owns 80 and 443), so the certificate is obtained over the
# TLS-ALPN challenge — automatic, as long as the router forwards outside port 443 here
# and the origin's domain resolves to it.
#
# The path list must stay matched EXACTLY as the API mounts it, with no stripping —
# the API canonicalizes one leading /api off itself, and a strip here would
# double-strip /api/api/… shapes. See deploy/selfhost/Caddyfile for the full argument.

${ORIGIN} {
	@api path /api /api/* /auth /auth/* /events /health /hello /pair /pair/* /internal /internal/*
	handle @api {
		reverse_proxy ohmail_api_1:8080
	}

	# The staging bucket's browser door — deploy/selfhost/Caddyfile's staging route with
	# the Umbrel container name. Browser attachment uploads are presigned against THIS
	# origin and the Host is PRESERVED on the hop (Caddy's default; SigV4 signs the Host).
	# Exposing the path is safe only because the bucket is PRIVATE: unsigned requests 403.
	# Never attach an anonymous policy to the bucket.
	@staging path /${BUCKET}/*
	handle @staging {
		reverse_proxy ohmail_minio_1:9000
	}

	handle {
		reverse_proxy ohmail_web_1:3000
	}
}

# The launcher site, plain HTTP on an internal port. Umbrel's own app proxy points
# here, so the dashboard's "Open" button lands on the real https origin instead of an
# address whose cookies cannot work.
:8099 {
	redir ${ORIGIN}{uri}
}
EOF
else
  cat > "${CADDYFILE}" <<'EOF'
# Rendered by hooks/pre-start — do not edit; change data/env/settings.env instead.
#
# OHMAIL_ORIGIN is not set yet, so the launcher site (the page Umbrel's "Open" button
# reaches) serves the setup steps instead of a redirect to nowhere. Set the origin in
# data/env/settings.env and restart the app; this file is then re-rendered with the
# real front door.
:8099 {
	header Content-Type "text/html; charset=utf-8"
	respond <<HTML
		<!doctype html>
		<html lang="en">
		<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>ohmail — one thing to set up</title>
		<style>
		body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 4rem auto; padding: 0 1.5rem; line-height: 1.6; color: #1a1a1a; background: #fafafa; }
		@media (prefers-color-scheme: dark) { body { color: #e8e8e8; background: #161616; } code { background: #2a2a2a; } }
		code { background: #ececec; padding: 0.1em 0.35em; border-radius: 4px; font-size: 0.95em; }
		h1 { font-size: 1.4rem; } ol { padding-left: 1.4rem; } li { margin-bottom: 0.8rem; }
		</style>
		</head>
		<body>
		<h1>ohmail is installed — one thing to set up</h1>
		<p>ohmail serves your household's mail over an https address of its own. Secure
		cookies and passkeys do not exist on plain <code>http://umbrel.local</code>, so the
		address must be <code>https://</code> — that is a rule in the server, not a preference.</p>
		<ol>
		<li>Point a domain at your home's public IP address — <code>mail.yourhome.example</code>.
		A dynamic-DNS name works if your home IP changes.</li>
		<li>On your router, forward outside port <strong>443</strong> to this Umbrel's port
		<strong>4443</strong>. The app fetches and renews its TLS certificate itself once
		traffic on 443 reaches it.</li>
		<li>Open a terminal on your Umbrel (Settings &rarr; Advanced &rarr; Terminal, or SSH)
		and set the one required line:<br>
		<code>nano ~/umbrel/app-data/ohmail/data/env/settings.env</code><br>
		<code>OHMAIL_ORIGIN=https://mail.yourhome.example</code></li>
		<li>Restart the ohmail app from the Umbrel dashboard, then open your address in a
		browser. A fresh server greets you with its setup page; the one-time setup token is
		in the app's log (Settings &rarr; Troubleshoot &rarr; ohmail).</li>
		</ol>
		<p>The full guide, including connecting your first mailbox, lives in the
		repository: <code>docs/self-host/UMBREL.md</code>.</p>
		</body>
		</html>
		HTML 200
}
EOF
fi

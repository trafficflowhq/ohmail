      <tr><td style="padding:18px 28px 0;">
        <h1 style="margin:0;font:600 20px/1.35 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1e1a16;letter-spacing:-0.01em;">You already have an ohmail account</h1>
      </td></tr>
      <tr><td style="padding:12px 28px 4px;font:400 15px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#5c534b;">
        <p style="margin:0 0 12px;">Someone just tried to create an ohmail account with this address. There is already one, so nothing was created and nothing changed.</p>
        <p style="margin:0 0 12px;">If that was you: sign in instead — your existing account is untouched.</p>
        <p style="margin:0 0 12px;">If it was not you: you can ignore this. Whoever tried was not told whether this address has an account, and they have no way in without your password or your passkey.</p>
      </td></tr>
          <tr><td style="padding:8px 28px 4px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td style="background:#a3461c;border-radius:10px;">
              <a href="https://ohmail.app/login" style="display:inline-block;padding:12px 22px;font:600 15px/1 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#ffffff;text-decoration:none;">Sign in to ohmail</a>
            </td></tr></table>
          </td></tr>
      <tr><td style="padding:20px 28px 26px;border-top:1px solid #e9e4de;font:400 13px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#5c534b;">
        <p style="margin:0 0 6px;">If the button does not work, open <a href="https://ohmail.app/login" style="color:#a3461c;">https://ohmail.app/login</a></p>
        <p style="margin:0 0 6px;">Reach a human: <a href="mailto:support@ohmail.app" style="color:#a3461c;">support@ohmail.app</a></p>
        <p style="margin:0 0 6px;">TrafficFlow GmbH, Zürich, Switzerland</p>
      </td></tr>
    </table>
  </td></tr>
</table>
</body>
</html>"
`;


exports[`templates — snapshots > invite subject/text/html is unchanged > invite.text 1`] = `
"oh. — ohmail

Your ohmail beta invite

Beta accounts are open and one is reserved for you.
Your invite code: OHMAIL-7QR4-2K9F
Redeem it here: https://app.ohmail.app/join?code=OHMAIL-7QR4-2K9F
The code stops working on 8 August 2026, 09:05 UTC. Keep it to yourself — anyone holding it can open an ohmail account.
You will be asked to set up a passkey (or an authenticator app) and to connect a mailbox you already own, which ohmail then organizes in place; nothing is copied into a new address.

—
Questions, or it will not work: support@ohmail.app
TrafficFlow GmbH, Zürich, Switzerland
"
`;

exports[`templates — snapshots > lifecycle_notice subject/text/html is unchanged > lifecycle_notice.headers 1`] = `null`;

exports[`templates — snapshots > lifecycle_notice subject/text/html is unchanged > lifecycle_notice.html 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>Your ohmail subscription has ended</title>
</head>
<body style="margin:0;padding:0;background:#f7f5f3;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f7f5f3;">
  <tr><td align="center" style="padding:28px 12px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;background:#ffffff;border:1px solid #e9e4de;border-radius:14px;">
      <tr><td style="padding:26px 28px 0;">
        <span style="font:600 22px/1 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1e1a16;letter-spacing:-0.03em;">oh<span style="color:#a3461c;">.</span></span>
      </td></tr>
      <tr><td style="padding:18px 28px 0;">
        <h1 style="margin:0;font:600 20px/1.35 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1e1a16;letter-spacing:-0.01em;">Your ohmail subscription has ended</h1>
      </td></tr>
      <tr><td style="padding:12px 28px 4px;font:400 15px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#5c534b;">
        <p style="margin:0 0 12px;">Your subscription ended on 16 September 2026, 00:00 UTC, so ohmail has stopped organizing and syncing. Your mailbox is untouched and stays yours — the mail lives on your own mail server.</p>
        <p style="margin:0 0 12px;">Sign in to subscribe again, export your settings, or delete your account.</p>
        <p style="margin:0 0 12px;">If you do nothing, your ohmail account data — rules, Screener decisions and settings — is erased on 16 October 2026, 00:00 UTC.</p>
      </td></tr>
          <tr><td style="padding:8px 28px 4px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td style="background:#a3461c;border-radius:10px;">
              <a href="https://app.ohmail.app/settings/account" style="display:inline-block;padding:12px 22px;font:600 15px/1 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#ffffff;text-decoration:none;">Open your ohmail account</a>

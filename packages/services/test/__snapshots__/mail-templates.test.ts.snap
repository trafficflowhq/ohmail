exports[`templates — snapshots > connect_reminder subject/text/html is unchanged > connect_reminder.html 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>Connect your mailbox to ohmail</title>
</head>
<body style="margin:0;padding:0;background:#f7f5f3;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f7f5f3;">
  <tr><td align="center" style="padding:28px 12px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;background:#ffffff;border:1px solid #e9e4de;border-radius:14px;">
      <tr><td style="padding:26px 28px 0;">
        <span style="font:600 22px/1 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1e1a16;letter-spacing:-0.03em;">oh<span style="color:#a3461c;">.</span></span>
      </td></tr>
      <tr><td style="padding:18px 28px 0;">
        <h1 style="margin:0;font:600 20px/1.35 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1e1a16;letter-spacing:-0.01em;">Connect your mailbox to ohmail</h1>
      </td></tr>
      <tr><td style="padding:12px 28px 4px;font:400 15px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#5c534b;">
        <p style="margin:0 0 12px;">You started an ohmail trial, but no mailbox is connected yet, so ohmail has no mail to organize for you.</p>
        <p style="margin:0 0 12px;">Most providers ask for an app password rather than your usual password, and the mailbox step says where to make one. If your mail is in a Microsoft 365 work or school account, connect it in Settings → Mailboxes with Connect Outlook instead: you sign in with Microsoft and need no app password.</p>
        <p style="margin:0 0 12px;">The button below opens the mailbox step, through sign-in if needed. Connecting takes a few minutes.</p>
      </td></tr>
          <tr><td style="padding:8px 28px 4px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td style="background:#a3461c;border-radius:10px;">
              <a href="https://app.ohmail.app/login?next=join" style="display:inline-block;padding:12px 22px;font:600 15px/1 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#ffffff;text-decoration:none;">Connect your mailbox</a>
            </td></tr></table>
          </td></tr>
      <tr><td style="padding:20px 28px 26px;border-top:1px solid #e9e4de;font:400 13px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#5c534b;">
        <p style="margin:0 0 6px;">We send this reminder once. Questions, or stuck? Reply to this mail and a person answers.</p>
        <p style="margin:0 0 6px;">TrafficFlow GmbH, Zürich, Switzerland</p>
      </td></tr>
    </table>
  </td></tr>
</table>
</body>
</html>"
`;

exports[`templates — snapshots > connect_reminder subject/text/html is unchanged > connect_reminder.subject 1`] = `"Connect your mailbox to ohmail"`;

exports[`templates — snapshots > connect_reminder subject/text/html is unchanged > connect_reminder.text 1`] = `
"oh. — ohmail

Connect your mailbox to ohmail

You started an ohmail trial, but no mailbox is connected yet, so ohmail has no mail to organize for you.
Most providers ask for an app password rather than your usual password, and the mailbox step says where to make one. If your mail is in a Microsoft 365 work or school account, connect it in Settings → Mailboxes with Connect Outlook instead: you sign in with Microsoft and need no app password.
The button below opens the mailbox step, through sign-in if needed. Connecting takes a few minutes.
https://app.ohmail.app/login?next=join

—
We send this reminder once. Questions, or stuck? Reply to this mail and a person answers.
TrafficFlow GmbH, Zürich, Switzerland
"
`;


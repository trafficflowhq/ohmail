# syntax=docker/dockerfile:1
#
# ohmail sync organizer — the SELF-HOST image (`ghcr.io/trafficflowhq/ohmail-worker`).
#
# TWO RECIPES, ONE PROCESS, and the split is deliberate. The sibling `Dockerfile` is the
# managed deployment's recipe: it builds in the development workspace, whose pnpm layout and
# lockfile the public repository does not carry. THIS file is the recipe the public
# repository's own release workflow builds and publishes — from the published tree, with its
# own toolchain: `npm ci` against the committed package-lock.json, then a single-file
# esbuild bundle with the same pinned bundler the desktop mail engine is built with
# (`scripts/bundle-host.mjs` carries the reasoning and the entry-stub story).
#
# THE ORGANIZER'S DEPENDENCY BOUNDARY IS ENFORCED BY THE BUILD CONTEXT. This process's
# runtime closure is core + db (+ db-mail's journal constants) and nothing else — notably
# never `@trafficflow/services`, whose HTML sanitiser and parser have no business in the
# boot graph of the process that holds every mailbox credential. The sibling
# `Dockerfile.selfhost.dockerignore` is the allow-list that admits exactly that closure; an
# import reaching outside it resolves to a workspace link whose target holds only a
# manifest, and the BUNDLE fails to build. Same fail-at-build-time property the managed
# recipe's filtered install buys, enforced by what the context contains.
#
# The runtime stage carries the bundle and the two journals — no src/, no test/, no
# node_modules. The release pipeline's image-prune check proves the absences with
# `docker run … find` rather than trusting this comment.
#
# The build context is the REPO ROOT (this app imports its sibling workspace packages).

# ── Base: pinned runtime ─────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS base
ENV CI=true
WORKDIR /app

# ── Build: the locked tree, then one file ────────────────────────────────────────────────
FROM base AS build
COPY . .

# WHICH ALLOW-LIST BUILT THIS CONTEXT. The lockfile above reaches it through the sibling
# `apps/worker/Dockerfile.selfhost.dockerignore`, and only BuildKit reads a per-Dockerfile list. The legacy
# builder falls back to the root one — the managed worker's context, which admits no lockfile — so
# npm answers EUSAGE over a lockfile this repository does commit, and the reader goes looking for a
# missing file instead of a missing builder. The builder is named here, before npm is asked.
RUN test -f package-lock.json || { \
      echo "REFUSED: package-lock.json is not in this build context."; \
      echo "  It IS committed at the repository root. This image's context list is the sibling"; \
      echo "  apps/worker/Dockerfile.selfhost.dockerignore, which only BuildKit reads."; \
      echo "  The legacy builder cannot build this image: install the buildx component"; \
      echo "  (https://docs.docker.com/go/buildx/) and build again."; \
      exit 1; }
RUN npm ci --no-audit --no-fund
RUN mkdir -p /tmp/esbuild && cd /tmp/esbuild && npm install --no-save esbuild@0.24.0
RUN OHMAIL_ESBUILD_FROM=/tmp/esbuild node scripts/bundle-host.mjs worker
RUN test -f build/host-worker/bin/ohmail-worker.mjs \
 && test -d build/host-worker/drizzle \
 && test -d build/host-worker/drizzle-cloud

# ── Runtime ──────────────────────────────────────────────────────────────────────────────
FROM base AS runtime
ENV NODE_ENV=production
# A JS heap ceiling below the container cap means the engine aborts with a heap trace on
# stderr instead of the kernel SIGKILLing the process — a SIGKILL is unloggable, and in one
# early outage that is why the whole deployment log read "Starting Container" and nothing
# else.
#
# BE HONEST ABOUT WHAT THIS DOES NOT DO: RFC822 bodies are Buffers, which live in the
# engine's EXTERNAL memory, not the JS heap — this flag does not bound them. The actual
# memory bound is the per-cycle batch budget in `packages/core/src/adapters/imap-types.ts`.
# This is a visibility aid and headroom, only.
ENV NODE_OPTIONS="--max-old-space-size=512"
# glibc gives a thread that first allocates under contention its own 64 MB arena and returns
# those bytes only from the top of one, so a burst leaves them resident for the life of the
# process — measured on the desktop engine as one +92.9 MB step in rss with the JS heap FALLING
# across it. The variable is read at process start, so this is the only place it can be set for
# an image. The value is the ENGINE's, measured; these processes talk to a real Postgres rather
# than a WASM one and their own throughput under it is owed.
ENV MALLOC_ARENA_MAX=2
COPY --from=build --chown=node:node /app/build/host-worker /app
USER node
# The health server binds PORT (defaulting to 8080), which the compose healthcheck polls.
EXPOSE 8080
CMD ["node", "/app/bin/ohmail-worker.mjs"]

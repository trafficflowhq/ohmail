<?xml version="1.0" encoding="utf-8"?>
<!-- The calendar app's widgets (WidgetModel.kt says what each shows; CalendarWidgets.kt fills them). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ohcal_n" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/ohcal_widget_sheet" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp">
  <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
  <LinearLayout android:id="@+id/ohcal_n_head" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/ohcal_n_weekday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink_2" android:textStyle="bold" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
      <TextView android:id="@+id/ohcal_n_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="40sp" android:textColor="@color/ohcal_widget_ink" android:textStyle="bold" />
      <TextView android:id="@+id/ohcal_n_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="40sp" android:textColor="@color/ohcal_widget_hot" android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
    <TextView android:id="@+id/ohcal_n_open" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ohcal_widget_hot" android:textStyle="bold" android:visibility="gone" android:layout_gravity="top|end" />
  </FrameLayout>
  <LinearLayout android:id="@+id/ohcal_n_r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp" android:visibility="gone">

    <TextView android:id="@+id/ohcal_n_r1_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/ohcal_n_r1_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink_2" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <LinearLayout android:id="@+id/ohcal_n_r2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp" android:visibility="gone">

    <TextView android:id="@+id/ohcal_n_r2_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/ohcal_n_r2_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink_2" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <TextView android:id="@+id/ohcal_n_nothing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink_2" android:visibility="gone" />
</LinearLayout>

    </LinearLayout>
    <LinearLayout android:id="@+id/ohcal_w_day_5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
      <TextView android:id="@+id/ohcal_w_letter_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/ohcal_widget_ink_2" />
      <TextView android:id="@+id/ohcal_w_date_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/ohcal_widget_ink" android:textStyle="bold" />

      <TextView android:id="@+id/ohcal_w_mark_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/ohcal_widget_ink" />
    </LinearLayout>
    <LinearLayout android:id="@+id/ohcal_w_day_4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">

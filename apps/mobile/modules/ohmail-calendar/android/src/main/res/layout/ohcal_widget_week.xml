      <TextView android:id="@+id/ohcal_w_mark_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/ohcal_widget_ink" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/ohcal_w_r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="4dp" android:visibility="gone">
    <TextView android:id="@+id/ohcal_w_r1_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink_2" android:textStyle="bold" />
    <FrameLayout android:layout_width="8dp" android:layout_height="1dp" />
    <TextView android:id="@+id/ohcal_w_r1_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />

  </LinearLayout>
  <LinearLayout android:id="@+id/ohcal_w_r2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="4dp" android:visibility="gone">
    <TextView android:id="@+id/ohcal_w_r2_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink_2" android:textStyle="bold" />

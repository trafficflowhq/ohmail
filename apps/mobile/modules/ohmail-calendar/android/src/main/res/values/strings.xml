<?xml version="1.0" encoding="utf-8"?>
<!-- The calendar's alert words, one for one the catalogue's (packages/app/messages/frame.en.json,
     frame.systemNotice.alert*; the channel's name: calendar.en.json, calendar.landmark); a test holds them equal. -->
<resources>
  <string name="ohcal_alert_channel">Calendar</string>
  <string name="ohcal_alert_busy">Busy</string>
  <string name="ohcal_alert_event">Event</string>
  <string name="ohcal_alert_now">Starts now.</string>
  <plurals name="ohcal_alert_minutes">
    <item quantity="one">Starts in one minute.</item>
    <item quantity="other">Starts in %d minutes.</item>
  </plurals>
  <plurals name="ohcal_alert_hours">
    <item quantity="one">Starts in one hour.</item>
    <item quantity="other">Starts in %d hours.</item>
  </plurals>
  <plurals name="ohcal_alert_days">
    <item quantity="one">Starts in one day.</item>
    <item quantity="other">Starts in %d days.</item>
  </plurals>
  <plurals name="ohcal_alert_weeks">
    <item quantity="one">Starts in one week.</item>
    <item quantity="other">Starts in %d weeks.</item>
  </plurals>
  <string name="ohcal_alert_today">Today, all day.</string>
  <string name="ohcal_alert_tomorrow">Tomorrow, all day.</string>
  <string name="ohcal_alert_all_days">In %d days, all day.</string>
  <plurals name="ohcal_alert_all_weeks">
    <item quantity="one">In one week, all day.</item>
    <item quantity="other">In %d weeks, all day.</item>
  </plurals>
  <!-- The widgets' words, one for one the catalogue's: agenda.until and agenda.nothing, calmail.now and
       calmail.toAnswer, month.more; the widgets' names agenda.month, calendar.today, calsettings.view.week. The
       language picks the weekday's and the month's names, so one widget speaks one language. -->
  <string name="ohcal_widget_language">en</string>
  <string name="ohcal_widget_now">now</string>
  <string name="ohcal_widget_until">until %1$s</string>
  <string name="ohcal_widget_more">+%d</string>
  <string name="ohcal_widget_to_answer">To answer</string>
  <string name="ohcal_widget_nothing">Nothing</string>
  <string name="ohcal_widget_month">Month</string>
  <string name="ohcal_widget_today">Today</string>
  <string name="ohcal_widget_week">Week</string>
</resources>

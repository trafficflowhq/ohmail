<?xml version="1.0" encoding="utf-8"?>
<!-- The calendar app's widgets (WidgetModel.kt says what each shows; CalendarWidgets.kt fills them). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ohcal_t" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/ohcal_widget_sheet" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
    <LinearLayout android:id="@+id/ohcal_t_head" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView android:id="@+id/ohcal_t_weekday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink_2" android:textStyle="bold" />
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/ohcal_t_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="52sp" android:textColor="@color/ohcal_widget_ink" android:textStyle="bold" />
        <TextView android:id="@+id/ohcal_t_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="52sp" android:textColor="@color/ohcal_widget_hot" android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="16dp" android:layout_height="1dp" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
      <LinearLayout android:id="@+id/ohcal_t_r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="4dp" android:visibility="gone">
        <TextView android:id="@+id/ohcal_t_r1_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink_2" android:textStyle="bold" />
        <FrameLayout android:layout_width="8dp" android:layout_height="1dp" />
        <TextView android:id="@+id/ohcal_t_r1_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />

      </LinearLayout>
      <LinearLayout android:id="@+id/ohcal_t_r2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="4dp" android:visibility="gone">
        <TextView android:id="@+id/ohcal_t_r2_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink_2" android:textStyle="bold" />
        <FrameLayout android:layout_width="8dp" android:layout_height="1dp" />
        <TextView android:id="@+id/ohcal_t_r2_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />

      </LinearLayout>
      <LinearLayout android:id="@+id/ohcal_t_r3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="4dp" android:visibility="gone">
        <TextView android:id="@+id/ohcal_t_r3_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink_2" android:textStyle="bold" />
        <FrameLayout android:layout_width="8dp" android:layout_height="1dp" />
        <TextView android:id="@+id/ohcal_t_r3_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />

      </LinearLayout>
      <TextView android:id="@+id/ohcal_t_more" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink_2" android:visibility="gone" />
      <TextView android:id="@+id/ohcal_t_nothing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ohcal_widget_ink_2" android:visibility="gone" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>

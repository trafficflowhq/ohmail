<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    THE CALENDAR'S ALERTS. The alarm's receiver is this app's alone (not exported): only the alarms this module set
    reach it. The restart's receiver takes the system's two broadcasts that drop an app's alarms, a restart and an
    update of the app, which no other app may send. Exact alarms are not asked for here: only the calendar's app
    declares them (plugins/calendar-native.js), and the mail app rings by the plain kind.
  -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <receiver android:name="app.ohmail.calendar.CalendarAlertReceiver" android:exported="false" />
    <receiver android:name="app.ohmail.calendar.CalendarRestartReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>

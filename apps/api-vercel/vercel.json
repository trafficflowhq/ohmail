{
  "crons": [
    {
      "path": "/internal/alerts/run",
      "schedule": "*/2 * * * *"
    }
  ],
  "functions": {
    "app/events/route.ts": {
      "memory": 1024,
      "supportsCancellation": true
    },
    "app/**/route.ts": {
      "memory": 1024
    }
  },
  "installCommand": "cd ../.. && npx --yes npm@10.9.8 ci --ignore-scripts && node scripts/apply-patches.mjs apply"
}

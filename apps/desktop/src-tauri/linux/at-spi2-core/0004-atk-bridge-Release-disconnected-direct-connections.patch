Upstream: https://gitlab.gnome.org/GNOME/at-spi2-core/-/commit/750687342c903880c410fc0634dba6fa6d792450 (backported)
From: Azamat Almazbek uulu
Date: Thu, 3 Sep 2026 14:38:38 +0200
Subject: [PATCH 4/5] atk-bridge: Release disconnected direct connections

Direct peer connections are retained until bridge shutdown. Release each connection when libdbus emits its local Disconnected signal so its routing state and credentials do not accumulate.

Add a regression test that checks pidfds are released after repeated direct connections.

[ohmail: upstream commit https://gitlab.gnome.org/GNOME/at-spi2-core/-/commit/750687342c903880c410fc0634dba6fa6d792450,
first in at-spi2-core 2.62.0; backported to 2.52.0, context only. 2.52 tears the bus down
inline in atk_bridge_adaptor_cleanup instead of calling deactivate_bus, and that
cleanup is not guarded by DISABLE_P2P, so the two new helpers sit ahead of the
#ifndef DISABLE_P2P block instead of inside it. The added and removed lines are
upstream's, +43/-9 in bridge.c as upstream.]

Signed-off-by: Azamat Almazbek uulu (address in the upstream commit)
---
 atk-adaptor/bridge.c                       |  52 +++-
 tests/at-spi2-atk/meson.build              |  12 +
 tests/at-spi2-atk/test-direct-connection.c | 296 +++++++++++++++++++++
 3 files changed, 351 insertions(+), 9 deletions(-)
 create mode 100644 tests/at-spi2-atk/test-direct-connection.c

diff --git a/atk-adaptor/bridge.c b/atk-adaptor/bridge.c
index 899cf32..02a9f36 100644
--- a/atk-adaptor/bridge.c
+++ b/atk-adaptor/bridge.c
@@ -630,6 +630,38 @@ install_plug_hooks ()
   socket_class->embed = socket_embed_hook;
 }
 
+static void
+remove_direct_connection (DBusConnection *connection)
+{
+  GList *link;
+
+  link = g_list_find (spi_global_app_data->direct_connections, connection);
+  if (!link)
+    return;
+
+  droute_context_unregister (spi_global_app_data->droute, connection);
+  droute_unintercept_dbus (connection);
+  spi_global_app_data->direct_connections =
+      g_list_delete_link (spi_global_app_data->direct_connections, link);
+  dbus_connection_unref (connection);
+}
+
+static DBusHandlerResult
+direct_connection_filter (DBusConnection *connection,
+                          DBusMessage *message,
+                          void *user_data)
+{
+  if (dbus_message_is_signal (message, DBUS_INTERFACE_LOCAL, "Disconnected"))
+    {
+      dbus_connection_remove_filter (connection,
+                                     direct_connection_filter,
+                                     NULL);
+      remove_direct_connection (connection);
+    }
+
+  return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+}
+
 #ifndef DISABLE_P2P
 static guint
 get_ancestral_uid (guint pid)
@@ -680,12 +712,16 @@ static void
 new_connection_cb (DBusServer *server, DBusConnection *con, void *data)
 {
   dbus_connection_set_unix_user_function (con, user_check, NULL, NULL);
+  if (!dbus_connection_add_filter (con, direct_connection_filter, NULL, NULL))
+    return;
+
   dbus_connection_ref (con);
   atspi_dbus_connection_setup_with_g_main (con, spi_context);
   droute_intercept_dbus (con);
   droute_context_register (spi_global_app_data->droute, con);
 
-  spi_global_app_data->direct_connections = g_list_append (spi_global_app_data->direct_connections, con);
+  spi_global_app_data->direct_connections =
+      g_list_append (spi_global_app_data->direct_connections, con);
 }
 #endif
 
@@ -1207,7 +1243,6 @@ atk_bridge_adaptor_init (gint *argc, gchar **argv[])
 void
 atk_bridge_adaptor_cleanup (void)
 {
-  GList *l;
   GSList *ls;
 
   if (!inited)
@@ -1250,19 +1285,18 @@ atk_bridge_adaptor_cleanup (void)
       spi_global_app_data->bus = NULL;
     }
 
-  for (l = spi_global_app_data->direct_connections; l; l = l->next)
+  while (spi_global_app_data->direct_connections)
     {
       DBusConnection *connection;
 
-      connection = l->data;
+      connection = spi_global_app_data->direct_connections->data;
 
-      droute_context_unregister (spi_global_app_data->droute, connection);
-      droute_unintercept_dbus (connection);
+      dbus_connection_remove_filter (connection,
+                                     direct_connection_filter,
+                                     NULL);
       dbus_connection_close (connection);
-      dbus_connection_unref (connection);
+      remove_direct_connection (connection);
     }
-  g_list_free (spi_global_app_data->direct_connections);
-  spi_global_app_data->direct_connections = NULL;
 
   for (ls = clients; ls; ls = ls->next)
     g_free (ls->data);
diff --git a/tests/at-spi2-atk/meson.build b/tests/at-spi2-atk/meson.build
index 4caf5d9..0c748a4 100644
--- a/tests/at-spi2-atk/meson.build
+++ b/tests/at-spi2-atk/meson.build
@@ -79,4 +79,16 @@ foreach t: tests
   endif
 endforeach
 
+direct_connection_test_bin = executable(
+  'direct-connection-test',
+  'test-direct-connection.c',
+  dependencies: gio_dep,
+  c_args: [
+    '-DTESTS_BUILD_DIR="@0@"'.format(meson.current_build_dir()),
+    '-DTESTS_DATA_DIR="@0@"'.format(join_paths(meson.current_source_dir(), 'data')),
+  ],
+)
+
+test('direct-connection', direct_connection_test_bin, timeout: 30)
+
 test('atk-test', atk_test_bin, timeout: 300)
diff --git a/tests/at-spi2-atk/test-direct-connection.c b/tests/at-spi2-atk/test-direct-connection.c
new file mode 100644
index 0000000..1fad3a7
--- /dev/null
+++ b/tests/at-spi2-atk/test-direct-connection.c
@@ -0,0 +1,296 @@
+/*
+ * AT-SPI - Assistive Technology Service Provider Interface
+ *
+ * Copyright 2026 Azamat Almazbek uulu

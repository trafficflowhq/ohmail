diff --git a/tests/at-spi2-atk/test-cache-departed.c b/tests/at-spi2-atk/test-cache-departed.c
new file mode 100644
index 0000000..cbbf513
--- /dev/null
+++ b/tests/at-spi2-atk/test-cache-departed.c
@@ -0,0 +1,106 @@
+/*
+ * AT-SPI - Assistive Technology Service Provider Interface
+ *
+ * An object that is queued for the cache, goes defunct, is cached again from
+ * the queue and is then finalized must leave the cache: Cache.GetItems refs
+ * and unrefs every entry, so an entry left behind is a use-after-free in
+ * every client that discovers the application.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include "bridge-fixture.h"
+
+#include "accessible-cache.h"
+#include "accessible-register.h"
+
+static gboolean
+cached (gpointer obj)
+{
+  return spi_cache_in (spi_global_cache, G_OBJECT (obj));
+}
+
+static void
+mark_finalized (gpointer data, GObject *where_the_object_was)
+{
+  *(gboolean *) data = TRUE;
+}
+
+static void
+test_departed_object_leaves_cache (void)
+{
+  BridgeFixture fixture = { 0 };
+  AtkObject *root = fixture_node_new ();
+  AtkObject *live = fixture_node_new ();
+  AtkObject *departing = fixture_node_new ();
+  gboolean finalized = FALSE;
+  gpointer departed;
+  GVariant *reply, *items, *item;
+  GHashTable *paths;
+  gchar *live_path;
+  gsize i;
+
+  /* Both are in the tree before the bridge starts: an object the bridge
+   * reports while it is outside the cache is leased for 16 s, and the test
+   * needs the departing one finalized when it lets go of it. */
+  fixture_node_append (root, live);
+  fixture_node_append (root, departing);
+  fixture_up (&fixture, root);
+  g_assert_true (cached (live));
+  g_assert_true (cached (departing));
+
+  /* Queued again, then defunct before the queue drains: the defunct
+   * notice takes it out of the cache, the queue puts it back. */
+  fixture_node_announce (root, departing);
+  fixture_node_set_defunct (departing);
+  g_assert_false (cached (departing));
+  g_assert_true (fixture_iterate_until (cached, departing));
+
+  g_object_weak_ref (G_OBJECT (departing), mark_finalized, &finalized);
+  departed = departing;
+  fixture_node_remove (root, departing);
+  g_object_unref (departing);
+  g_assert_true (finalized);
+
+  g_assert_false (spi_cache_in (spi_global_cache, departed));
+
+  /* GetItems answers with the live objects only (and, under
+   * G_DEBUG=fatal-criticals, refs nothing that is gone). */
+  reply = fixture_call (fixture.client, fixture.app_name, "/org/a11y/atspi/cache",
+                        "org.a11y.atspi.Cache", "GetItems", NULL);
+  items = g_variant_get_child_value (reply, 0);
+  paths = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  for (i = 0; i < g_variant_n_children (items); i++)
+    {
+      const gchar *path;
+
+      item = g_variant_get_child_value (items, i);
+      g_variant_get_child (item, 0, "(&s&o)", NULL, &path);
+      g_hash_table_add (paths, g_strdup (path));
+      g_variant_unref (item);
+    }
+  live_path = spi_register_object_to_path (spi_global_register, G_OBJECT (live));
+  g_assert_cmpuint (g_variant_n_children (items), ==, 2);
+  g_assert_true (g_hash_table_contains (paths, FIXTURE_ROOT_PATH));
+  g_assert_true (g_hash_table_contains (paths, live_path));
+
+  g_free (live_path);
+  g_hash_table_unref (paths);
+  g_variant_unref (items);
+  g_variant_unref (reply);
+  fixture_down (&fixture);
+  g_object_unref (live);
+  g_object_unref (root);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/atk-bridge/cache/departed-object-leaves-cache",
+                   test_departed_object_leaves_cache);
+  return g_test_run ();
+}

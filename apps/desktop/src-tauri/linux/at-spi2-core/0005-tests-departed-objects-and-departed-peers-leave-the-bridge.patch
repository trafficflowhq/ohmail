+/*
+ * AT-SPI - Assistive Technology Service Provider Interface
+ *
+ * In-process fixture for tests that read the bridge's own state: the
+ * bridge runs in the test process, on a private bus that serves as the
+ * accessibility bus, over a tree of plain AtkObjects the test controls.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#ifndef BRIDGE_FIXTURE_H
+#define BRIDGE_FIXTURE_H
+
+#include <atk/atk.h>
+#include <gio/gio.h>
+
+G_BEGIN_DECLS
+
+#define FIXTURE_ROOT_PATH "/org/a11y/atspi/accessible/root"
+
+typedef struct
+{
+  GTestDBus *bus;
+  gchar *runtime_dir;
+  GDBusConnection *client;
+  gchar *app_name;
+  gchar *app_address;
+} BridgeFixture;
+
+AtkObject *fixture_node_new (void);
+void fixture_node_append (AtkObject *parent, AtkObject *child);
+void fixture_node_announce (AtkObject *parent, AtkObject *child);
+void fixture_node_remove (AtkObject *parent, AtkObject *child);
+void fixture_node_set_defunct (AtkObject *node);
+
+void fixture_up (BridgeFixture *fixture, AtkObject *root);
+void fixture_down (BridgeFixture *fixture);
+
+GVariant *fixture_call (GDBusConnection *connection,
+                        const gchar *dest,
+                        const gchar *path,
+                        const gchar *iface,
+                        const gchar *method,
+                        const GVariantType *reply_type);
+
+gboolean fixture_iterate_until (gboolean (*done) (gpointer), gpointer data);
+
+G_END_DECLS
+
+#endif /* BRIDGE_FIXTURE_H */

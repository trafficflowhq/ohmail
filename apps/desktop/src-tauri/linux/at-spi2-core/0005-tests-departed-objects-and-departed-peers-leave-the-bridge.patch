diff --git a/tests/at-spi2-atk/bridge-fixture.c b/tests/at-spi2-atk/bridge-fixture.c
new file mode 100644
index 0000000..bfcea00
--- /dev/null
+++ b/tests/at-spi2-atk/bridge-fixture.c
@@ -0,0 +1,258 @@
+/*
+ * AT-SPI - Assistive Technology Service Provider Interface
+ *
+ * In-process fixture for tests that read the bridge's own state.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include "bridge-fixture.h"
+
+#include "accessible-cache.h"
+#include "bridge.h"
+#include <atk-bridge.h>
+#include <glib/gstdio.h>
+
+/* A node with a child list and a state set the test sets by hand. */
+
+typedef struct
+{
+  AtkObject parent;
+  GPtrArray *children;
+  AtkStateSet *states;
+} FixtureNode;
+
+typedef struct
+{
+  AtkObjectClass parent_class;
+} FixtureNodeClass;
+
+G_DEFINE_TYPE (FixtureNode, fixture_node, ATK_TYPE_OBJECT)
+
+#define FIXTURE_NODE(o) ((FixtureNode *) (o))
+
+static gint
+fixture_node_get_n_children (AtkObject *obj)
+{
+  return FIXTURE_NODE (obj)->children->len;
+}
+
+static AtkObject *
+fixture_node_ref_child (AtkObject *obj, gint i)
+{
+  FixtureNode *node = FIXTURE_NODE (obj);
+
+  if (i < 0 || (guint) i >= node->children->len)
+    return NULL;
+  return g_object_ref (g_ptr_array_index (node->children, i));
+}
+
+static AtkStateSet *
+fixture_node_ref_state_set (AtkObject *obj)
+{
+  return g_object_ref (FIXTURE_NODE (obj)->states);
+}
+
+static void
+fixture_node_finalize (GObject *obj)
+{
+  FixtureNode *node = FIXTURE_NODE (obj);
+
+  g_ptr_array_unref (node->children);
+  g_object_unref (node->states);
+  G_OBJECT_CLASS (fixture_node_parent_class)->finalize (obj);
+}
+
+static void
+fixture_node_init (FixtureNode *node)
+{
+  node->children = g_ptr_array_new_with_free_func (g_object_unref);
+  node->states = atk_state_set_new ();
+}
+
+static void
+fixture_node_class_init (FixtureNodeClass *klass)
+{
+  AtkObjectClass *atk_class = ATK_OBJECT_CLASS (klass);
+
+  G_OBJECT_CLASS (klass)->finalize = fixture_node_finalize;
+  atk_class->get_n_children = fixture_node_get_n_children;
+  atk_class->ref_child = fixture_node_ref_child;
+  atk_class->ref_state_set = fixture_node_ref_state_set;
+}
+
+AtkObject *
+fixture_node_new (void)
+{
+  AtkObject *node = g_object_new (fixture_node_get_type (), NULL);
+
+  atk_object_set_role (node, ATK_ROLE_PANEL);
+  return node;
+}
+
+void
+fixture_node_append (AtkObject *parent, AtkObject *child)
+{
+  g_ptr_array_add (FIXTURE_NODE (parent)->children, g_object_ref (child));
+  atk_object_set_parent (child, parent);
+}
+
+/* What a toolkit emits when the child appears; the bridge queues it. */
+void
+fixture_node_announce (AtkObject *parent, AtkObject *child)
+{
+  guint index;
+
+  g_assert_true (g_ptr_array_find (FIXTURE_NODE (parent)->children, child, &index));
+  g_signal_emit_by_name (parent, "children-changed::add", index, child);
+}
+
+void
+fixture_node_remove (AtkObject *parent, AtkObject *child)
+{
+  g_assert_true (g_ptr_array_remove (FIXTURE_NODE (parent)->children, child));
+}
+
+void
+fixture_node_set_defunct (AtkObject *node)
+{
+  atk_state_set_add_state (FIXTURE_NODE (node)->states, ATK_STATE_DEFUNCT);
+  atk_object_notify_state_change (node, ATK_STATE_DEFUNCT, TRUE);
+}
+
+/* The bridge: ATK's own AtkUtil listeners (emission hooks) and our root. */
+
+static AtkObject *fixture_root;
+
+static AtkObject *
+fixture_get_root (void)
+{
+  return fixture_root;
+}
+
+static gboolean
+deadline_passed (gpointer data)
+{
+  *(gboolean *) data = TRUE;
+  return G_SOURCE_REMOVE;
+}
+
+/* Runs the main loop until done() holds; FALSE when it never did. */
+gboolean
+fixture_iterate_until (gboolean (*done) (gpointer), gpointer data)
+{
+  gboolean expired = FALSE;
+  guint deadline = g_timeout_add_seconds (10, deadline_passed, &expired);
+
+  while (!done (data) && !expired)
+    g_main_context_iteration (NULL, TRUE);
+  if (!expired)
+    g_source_remove (deadline);
+  return done (data);
+}
+
+typedef struct
+{
+  gboolean finished;
+  GVariant *reply;
+  GError *error;
+} CallState;
+
+static gboolean
+call_finished (gpointer data)
+{
+  return ((CallState *) data)->finished;
+}
+
+static void
+call_done (GObject *source, GAsyncResult *res, gpointer data)
+{
+  CallState *state = data;
+
+  state->reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), res,
+                                                &state->error);
+  state->finished = TRUE;
+}
+
+/* A method call answered by the bridge in this process's main loop. */
+GVariant *
+fixture_call (GDBusConnection *connection,
+              const gchar *dest,
+              const gchar *path,
+              const gchar *iface,
+              const gchar *method,
+              const GVariantType *reply_type)
+{
+  CallState state = { 0 };
+
+  g_dbus_connection_call (connection, dest, path, iface, method, NULL,
+                          reply_type, G_DBUS_CALL_FLAGS_NONE, -1, NULL,
+                          call_done, &state);
+  g_assert_true (fixture_iterate_until (call_finished, &state));
+  g_assert_no_error (state.error);
+  return state.reply;
+}
+
+void
+fixture_up (BridgeFixture *fixture, AtkObject *root)
+{
+  gchar *argv_store[] = { "bridge-fixture", "--atspi-no-register", NULL };
+  gchar **argv = argv_store;
+  gint argc = 2;
+  AtkUtilClass *util;
+  GError *error = NULL;
+  GVariant *reply;
+
+  /* Only criticals are fatal: with no registry on the private bus the
+   * bridge warns about its registration replies. */
+  g_log_set_always_fatal (G_LOG_FATAL_MASK | G_LOG_LEVEL_CRITICAL);
+
+  fixture->runtime_dir = g_dir_make_tmp ("bridge-fixture-XXXXXX", &error);
+  g_assert_no_error (error);
+  g_setenv ("XDG_RUNTIME_DIR", fixture->runtime_dir, TRUE);
+
+  fixture->bus = g_test_dbus_new (G_TEST_DBUS_NONE);
+  g_test_dbus_up (fixture->bus);
+  g_setenv ("AT_SPI_BUS_ADDRESS", g_test_dbus_get_bus_address (fixture->bus), TRUE);
+
+  fixture_root = root;
+  util = g_type_class_ref (ATK_TYPE_UTIL);
+  util->get_root = fixture_get_root;
+  g_type_class_unref (util);
+
+  g_assert_cmpint (atk_bridge_adaptor_init (&argc, &argv), ==, 0);
+
+  fixture->client = g_dbus_connection_new_for_address_sync (
+      g_test_dbus_get_bus_address (fixture->bus),
+      G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT |
+          G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION,
+      NULL, NULL, &error);
+  g_assert_no_error (error);
+
+  /* A client's first call makes the bridge build its cache and listen. */
+  fixture->app_name = g_strdup (dbus_bus_get_unique_name (spi_global_app_data->bus));
+  reply = fixture_call (fixture->client, fixture->app_name, FIXTURE_ROOT_PATH,
+                        "org.a11y.atspi.Application", "GetApplicationBusAddress",
+                        G_VARIANT_TYPE ("(s)"));
+  g_variant_get (reply, "(s)", &fixture->app_address);
+  g_variant_unref (reply);
+  g_assert_nonnull (spi_global_cache);
+}
+
+void
+fixture_down (BridgeFixture *fixture)
+{
+  g_dbus_connection_close_sync (fixture->client, NULL, NULL);
+  g_clear_object (&fixture->client);
+  atk_bridge_adaptor_cleanup ();
+  g_test_dbus_down (fixture->bus);
+  g_clear_object (&fixture->bus);
+  g_rmdir (fixture->runtime_dir);
+  g_clear_pointer (&fixture->runtime_dir, g_free);
+  g_clear_pointer (&fixture->app_name, g_free);
+  g_clear_pointer (&fixture->app_address, g_free);
+  fixture_root = NULL;
+}

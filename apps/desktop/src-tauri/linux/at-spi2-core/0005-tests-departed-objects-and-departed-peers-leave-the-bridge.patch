+#include "bridge-fixture.h"
+#include "bridge.h"
 #include <gio/gio.h>
 #include <glib.h>
 #include <signal.h>
@@ -286,11 +288,125 @@ out:
   g_spawn_close_pid (app_pid);
 }
 
+/* The same property read in the bridge itself, where libdbus keeps no
+ * pidfd to count: the connections it still holds. */
+
+#define DEPARTING_PEERS 16
+
+static guint
+held_connections (void)
+{
+  return g_list_length (spi_global_app_data->direct_connections);
+}
+
+/* Every connection still held has seen its end and delivered it. */
+static gboolean
+departures_delivered (gpointer data)
+{
+  GList *l;
+
+  for (l = spi_global_app_data->direct_connections; l; l = l->next)
+    if (dbus_connection_get_is_connected (l->data) ||
+        dbus_connection_get_dispatch_status (l->data) != DBUS_DISPATCH_COMPLETE)
+      return FALSE;
+  return TRUE;
+}
+
+typedef struct
+{
+  GDBusConnection *peer;
+  GError *error;
+  gboolean finished;
+} PeerState;
+
+static gboolean
+peer_finished (gpointer data)
+{
+  return ((PeerState *) data)->finished;
+}
+
+static void
+peer_opened (GObject *source, GAsyncResult *res, gpointer data)
+{
+  PeerState *state = data;
+
+  state->peer = g_dbus_connection_new_for_address_finish (res, &state->error);
+  state->finished = TRUE;
+}
+
+static void
+peer_closed (GObject *source, GAsyncResult *res, gpointer data)
+{
+  PeerState *state = data;
+
+  g_dbus_connection_close_finish (G_DBUS_CONNECTION (source), res, &state->error);
+  state->finished = TRUE;
+}
+
+static void
+departed_peers_are_dropped (void)
+{
+  BridgeFixture fixture = { 0 };
+  AtkObject *root = fixture_node_new ();
+  guint i;
+
+  fixture_up (&fixture, root);
+  g_assert_cmpstr (fixture.app_address, !=, "");
+  g_assert_cmpuint (held_connections (), ==, 0);
+
+  for (i = 0; i < DEPARTING_PEERS; i++)
+    {
+      PeerState state = { 0 };
+      guint before = held_connections ();
+      GVariant *reply;
+
+      g_dbus_connection_new_for_address (fixture.app_address,
+                                         G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT,
+                                         NULL, NULL, peer_opened, &state);
+      g_assert_true (fixture_iterate_until (peer_finished, &state));
+      g_assert_no_error (state.error);
+
+      reply = fixture_call (state.peer, NULL, FIXTURE_ROOT_PATH,
+                            "org.a11y.atspi.Application", "GetApplicationBusAddress",
+                            G_VARIANT_TYPE ("(s)"));
+      g_variant_unref (reply);
+      g_assert_cmpuint (held_connections (), ==, before + 1);
+
+      state.finished = FALSE;
+      g_dbus_connection_close (state.peer, NULL, peer_closed, &state);
+      g_assert_true (fixture_iterate_until (peer_finished, &state));
+      g_assert_no_error (state.error);
+      g_clear_object (&state.peer);
+      g_assert_true (fixture_iterate_until (departures_delivered, NULL));
+    }
+
+  g_assert_cmpuint (held_connections (), ==, 0);
+
+  fixture_down (&fixture);
+  g_object_unref (root);
+}
+
+static void
+test_departed_peers_are_dropped (void)
+{
+  if (g_test_subprocess ())
+    {
+      departed_peers_are_dropped ();
+      return;
+    }
+  g_test_trap_subprocess (NULL, 0,
+                          G_TEST_SUBPROCESS_INHERIT_STDOUT |
+                              G_TEST_SUBPROCESS_INHERIT_STDERR);
+  g_test_trap_assert_passed ();
+}
+
 int
 main (int argc, char **argv)
 {
   g_test_init (&argc, &argv, NULL);
   g_test_add_func ("/atk-bridge/direct-connection-is-released",
                    test_direct_connection_is_released);
+  g_test_add_func ("/atk-bridge/departed-peers-are-dropped",
+                   test_departed_peers_are_dropped);
   return g_test_run ();
 }

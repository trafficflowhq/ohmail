<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- THE PREVIOUS macOS CLIENT'S BUNDLE METADATA, KEPT ON PURPOSE AFTER THAT CLIENT WAS RETIRED.

     macOS now ships the same application as Windows and Linux, bundled by Tauri from
     apps/desktop/src-tauri/tauri.conf.json and Info.plist. Nothing builds an app around THIS file
     any more, and it is published for two reasons that outlive the client it belonged to:

       · SUPublicEDKey below is the trust anchor of the HANDOVER. Every Mac still carrying the old
         client asks Sparkle for appcast-macos.xml, and installs what that feed offers only if the
         signature verifies against this key. The key is committed so anyone can check the feed
         against it themselves.
       · CFBundleIdentifier is the identity the new app deliberately keeps, so an update replaces
         the install rather than sitting beside it and addressing a different data directory.

     CFBundleVersion here is inert. What the handover is compared against is the CFBundleVersion of
     the shipped Tauri bundle; see apps/desktop/src-tauri/Info.plist. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>ohmail</string>
	<key>CFBundleExecutable</key>
	<string>OhMail</string>
	<key>CFBundleIconFile</key>
	<string>ohmail</string>
	<key>CFBundleIdentifier</key>
	<string>io.ohmail.desktop</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ohmail</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.9.5</string>
	<key>CFBundleVersion</key>
	<string>0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 TrafficFlow GmbH, Zürich. Licensed under GPL-3.0-or-later.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<!-- Sparkle auto-updater. The apps are unsigned, so this EdDSA public key is the whole of what
	     makes an update trustworthy: an archive is installed only if its signature verifies against
	     it. Its private half is held outside the repo and never shipped. This key must never be
	     removed or rotated on its own — an installed client verifies against the copy IT shipped
	     with, so the release workflow has to keep signing with the matching private half or those
	     installs can never take another update. -->
	<key>SUPublicEDKey</key>
	<string>yHMOFvqQ6/MzGRkj74xS3NH8kHU76w2LHh23Ss3i67I=</string>
	<!-- Where the older client looks for updates: one pinned HTTPS endpoint on the project's own
	     repo. The appcast served there is produced by the release CI and is published on EVERY
	     release, indefinitely — a client that has not been opened in a year still asks for it, and a
	     404 leaves that install where it is for ever. -->
	<key>SUFeedURL</key>
	<string>https://github.com/trafficflowhq/ohmail/releases/latest/download/appcast-macos.xml</string>
	<!-- Check on a schedule, but NEVER install silently: a found update is always presented for the
	     user to accept (notify-and-install). Daily is Sparkle's usual cadence. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>

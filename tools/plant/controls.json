      "  .place {",
      "    gap: var(--g-2);",
      "  }",
      "}"
    ]
  },
  {
    "id": "a feature restyles a kit class",
    "rule": "stylelint:selector-disallowed-list",
    "plant": "packages/app/src/planted/restyle.css",
    "expect": "refused",
    "source": [
      ".oh-button {",
      "  gap: var(--g-2);",
      "}"
    ]
  },
  {
    "id": "an unformatted file in a new package",
    "rule": "prettier",
    "plant": "packages/wire/src/planted/unformatted.ts",
    "expect": "refused",
    "source": [
      "export type   Loose = {a:string}"
    ]
  },
  {
    "id": "an unformatted file in the old tree",
    "rule": "prettier",
    "plant": "packages/core/src/planted/unformatted.ts",
    "expect": "passes",
    "source": [
      "export type   Loose = {a:string}"
    ]
  },
  {
    "id": "a project the type check does not reach",
    "rule": "references",
    "plant": "packages/planted-unreferenced/tsconfig.json",
    "expect": "refused",
    "source": [
      "{ \"compilerOptions\": { \"noEmit\": true } }"
    ]
  },
  {
    "id": "a clean file of shared behaviour",
    "rule": [
      "ohmail/package-borders",
      "ohmail/declared-dependency",
      "ohmail/platform-name",
      "max-lines",
      "max-lines-per-function",
      "react-hooks/exhaustive-deps",
      "react-hooks/rules-of-hooks",
      "no-restricted-globals",
      "no-restricted-imports",
      "no-empty",
      "@typescript-eslint/ban-ts-comment",
      "ohmail/no-inline-config",
      "eslint:unused-directive",
      "prettier"
    ],
    "plant": "packages/app-logic/src/planted/clean.ts",
    "expect": "passes",
    "source": [
      "import type { Engine } from \"@ohmail/client-engine\";",
      "",
      "export function titleOf(engine: Engine | null, fallback: string): string {",
      "  try {",
      "    return engine ? String(engine) : fallback;",
      "  } catch (error) {",
      "    throw new Error(fallback, { cause: error });",
      "  }",
      "}"
    ]
  },
  {
    "id": "a clean stylesheet of the kit",
    "rule": [
      "stylelint:color-no-hex",
      "stylelint:color-named",
      "stylelint:function-disallowed-list",
      "stylelint:declaration-property-unit-disallowed-list",
      "stylelint:selector-max-type",
      "stylelint:selector-class-pattern",
      "stylelint:comment-word-disallowed-list",
      "prettier"
    ],
    "plant": "packages/ui/src/planted/clean.css",
    "expect": "passes",
    "source": [
      "/* A planted part. */",
      ".oh-planted-clean {",
      "  color: var(--ink);",
      "  transition: opacity var(--dur-1) var(--ease-1);",
      "}"
    ]
  },
  {
    "id": "a clean stylesheet of a feature",
    "rule": [
      "stylelint:media-feature-name-disallowed-list",
      "stylelint:selector-disallowed-list"
    ],
    "plant": "packages/app/src/planted/clean.css",
    "expect": "passes",
    "source": [
      ".place {",
      "  gap: var(--g-2);",
      "}"
    ]
  },
  {
    "id": "a project the build references",
    "rule": "references",
    "plant": "packages/core/tsconfig.json",
    "expect": "passes"
  }
]

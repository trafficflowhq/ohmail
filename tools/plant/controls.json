      "  color: #fff;",
      "}"
    ]
  },
  {
    "id": "a width written into a feature",
    "rule": "stylelint:media-feature-name-disallowed-list",
    "plant": "packages/app/src/planted/media.css",
    "expect": "refused",
    "source": [

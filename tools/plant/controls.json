      "  color: var(--ink);",
      "}"
    ]
  },
  {
    "id": "a kit class without the prefix",
    "rule": "stylelint:selector-class-pattern",
    "plant": "packages/ui/src/planted/prefix.css",
    "expect": "refused",
    "source": [

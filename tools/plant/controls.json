      "  color: var(--ink);",
      "}"
    ]
  },
  {
    "id": "a style rule switched off in a stylesheet",
    "rule": "stylelint:comment-word-disallowed-list",
    "plant": "packages/ui/src/planted/switch-off.css",
    "expect": "refused",
    "source": [

    "plant": "packages/ui/src/planted/function.css",
    "expect": "refused",
    "source": [
      ".oh-planted-fn {",
      "  border: 1px solid rgb(0 0 0);",
      "}"
    ]
  },
  {
    "id": "a literal time in a shorthand",
    "rule": "stylelint:declaration-property-unit-disallowed-list",
    "plant": "packages/ui/src/planted/time.css",
    "expect": "refused",
    "source": [
      ".oh-planted-time {",
      "  transition: opacity 200ms;",
      "}"
    ]
  },
  {

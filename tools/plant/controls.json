[
  {
    "id": "support: packages/app/package.json",
    "plant": "packages/app/package.json",
    "source": [
      "{ \"name\": \"@ohmail/app\", \"version\": \"0.0.0\", \"private\": true, \"type\": \"module\" }"
    ]
  },
  {
    "id": "support: packages/app-logic/package.json",
    "plant": "packages/app-logic/package.json",
    "source": [
      "{",
      "  \"name\": \"@ohmail/app-logic\",",
      "  \"version\": \"0.0.0\",",
      "  \"private\": true,",
      "  \"type\": \"module\",",
      "  \"dependencies\": { \"@ohmail/client-engine\": \"*\" }",
      "}"
    ]
  },
  {
    "id": "support: packages/wire/package.json",
    "plant": "packages/wire/package.json",
    "source": [
      "{ \"name\": \"@ohmail/wire\", \"version\": \"0.0.0\", \"private\": true, \"type\": \"module\" }"
    ]
  },
  {
    "id": "the kit imports the engine",
    "rule": "ohmail/package-borders",
    "plant": "packages/ui/src/planted/border.ts",
    "expect": "refused",
    "source": [
      "import { createEngine } from \"@ohmail/client-engine\";",
      "",
      "export { createEngine };"
    ]
  },
  {
    "id": "the core imports the services by path",
    "rule": "ohmail/package-borders",
    "plant": "packages/core/src/planted/by-path.ts",
    "expect": "refused",
    "source": [
      "export { sendMessage } from \"../../../services/src/index.js\";"
    ]
  },
  {
    "id": "the web shell imports the worker by path",
    "rule": "ohmail/package-borders",
    "plant": "apps/webapp/app/planted/by-path.ts",
    "expect": "refused",
    "source": [
      "import \"../../../worker/src/index.js\";"
    ]
  },
  {
    "id": "the fallback door imports the server",
    "rule": "ohmail/package-borders",
    "plant": "apps/api-vercel/src/planted/server.ts",
    "expect": "passes",
    "source": [
      "import \"@ohmail/server\";"
    ]
  },
  {
    "id": "a feature imports a value of the engine",
    "rule": "ohmail/package-borders",
    "plant": "packages/app/src/planted/value.ts",
    "expect": "refused",
    "source": [
      "import { createEngine } from \"@ohmail/client-engine\";",
      "",
      "export { createEngine };"
    ]
  },
  {
    "id": "a feature imports a type of the engine",
    "rule": "ohmail/package-borders",
    "plant": "packages/app/src/planted/type.ts",
    "expect": "passes",
    "source": [
      "import type { Engine } from \"@ohmail/client-engine\";",
      "",
      "export type { Engine };"
    ]
  },
  {
    "id": "a kit test imports the test package",
    "rule": "ohmail/package-borders",
    "plant": "packages/ui/test/planted-testing.test.ts",
    "expect": "passes",
    "source": [
      "import \"@ohmail/fixtures\";"
    ]
  },
  {
    "id": "a kit test imports the services",
    "rule": "ohmail/package-borders",
    "plant": "packages/ui/test/planted-services.test.ts",
    "expect": "refused",
    "source": [
      "import \"@trafficflow/services\";"
    ]
  },
  {
    "id": "a dynamic import crosses a border",
    "rule": "ohmail/package-borders",
    "plant": "packages/ui/src/planted/dynamic.ts",
    "expect": "refused",
    "source": [
      "export const load = () => import(\"@trafficflow/db\");"
    ]
  },
  {
    "id": "a re-export crosses a border",
    "rule": "ohmail/package-borders",
    "plant": "packages/ui/src/planted/reexport.ts",
    "expect": "refused",
    "source": [
      "export * from \"@trafficflow/core\";"
    ]
  },
  {
    "id": "a require crosses a border",
    "rule": "ohmail/package-borders",
    "plant": "packages/ui/src/planted/require.cjs",
    "expect": "refused",
    "source": [
      "module.exports = require(\"@trafficflow/core\");"
    ]
  },
  {
    "id": "a folder without a row",
    "rule": "ohmail/package-borders",
    "plant": "packages/planted-no-row/src/index.ts",
    "expect": "refused",
    "source": [
      "export {};"
    ]
  },
  {
    "id": "an import the manifest does not declare",
    "rule": "ohmail/declared-dependency",
    "plant": "packages/db/src/planted/undeclared.ts",
    "expect": "refused",
    "source": [
      "import \"imapflow\";"
    ]
  },
  {
    "id": "an import the manifest declares",
    "rule": "ohmail/declared-dependency",
    "plant": "packages/db/src/planted/declared.ts",
    "expect": "passes",
    "source": [
      "import \"drizzle-orm\";"
    ]
  },
  {
    "id": "a platform's environment name in the core",
    "rule": "ohmail/platform-name",
    "plant": "packages/core/src/planted/platform.ts",
    "expect": "refused",
    "source": [
      "export const where = process.env.VERCEL_ENV;"
    ]
  },
  {
    "id": "the same name in a door file",
    "rule": "ohmail/platform-name",
    "plant": "apps/api-vercel/src/planted/platform.ts",
    "expect": "passes",
    "source": [
      "export const where = process.env.VERCEL_ENV;"
    ]
  },
  {
    "id": "a platform's name as a string",
    "rule": "ohmail/platform-name",
    "plant": "packages/core/src/planted/platform-literal.ts",
    "expect": "refused",
    "source": [
      "export const key = \"RAILWAY_REPLICA_ID\";"
    ]
  },
  {
    "id": "a platform's own package",
    "rule": "ohmail/platform-name",
    "plant": "packages/core/src/planted/platform-package.ts",
    "expect": "refused",
    "source": [
      "import \"@vercel/functions\";"
    ]
  },
  {
    "id": "the product's own names that carry a platform's word",
    "rule": "ohmail/platform-name",
    "plant": "packages/core/src/planted/own-name.ts",
    "expect": "passes",
    "source": [
      "export const token = process.env.TF_SIGNAL_VERCEL_TOKEN;",
      "export const VERCEL_REQUEST_LOGS_URL = \"https://example.invalid/logs\";"
    ]
  },
  {
    "id": "wire exports a value",
    "rule": "ohmail/wire-exports-no-value",
    "plant": "packages/wire/src/planted/value.ts",
    "expect": "refused",
    "source": [
      "export const version = 1;"
    ]
  },
  {
    "id": "wire exports types",
    "rule": "ohmail/wire-exports-no-value",
    "plant": "packages/wire/src/planted/types.ts",
    "expect": "passes",
    "source": [
      "export type Kind = \"mail\" | \"event\";",
      "export interface Ask {",
      "  kind: Kind;",
      "}"
    ]
  },
  {
    "id": "a 401-line file of interface code",
    "rule": "max-lines",
    "plant": "packages/app/src/planted/long.ts",
    "expect": "refused",
    "source": [
      {
        "repeat": "export const line{n} = {n};",
        "count": 401
      }
    ]
  },
  {
    "id": "a 401-line file of the core",
    "rule": "max-lines",
    "plant": "packages/core/src/planted/long.ts",
    "expect": "passes",
    "source": [
      {
        "repeat": "export const line{n} = {n};",
        "count": 401
      }
    ]
  },
  {
    "id": "a 121-line function",
    "rule": "max-lines-per-function",
    "plant": "packages/app-logic/src/planted/long-function.ts",
    "expect": "refused",
    "source": [
      "export function long(): number {",
      "  let sum = 0;",
      {
        "repeat": "  sum += {n};",
        "count": 118
      },
      "  return sum;",
      "}"
    ]
  },
  {
    "id": "an effect that leaves out what it depends on",
    "rule": "react-hooks/exhaustive-deps",
    "plant": "packages/app-logic/src/planted/hook-deps.ts",
    "expect": "refused",
    "source": [
      "import { useEffect } from \"react\";",
      "",
      "export function useLogged(title: string, log: (line: string) => void) {",
      "  useEffect(() => {",
      "    log(title);",
      "  }, []);",
      "}"
    ]
  },
  {
    "id": "a hook called under a condition",
    "rule": "react-hooks/rules-of-hooks",
    "plant": "packages/app-logic/src/planted/hook-order.ts",
    "expect": "refused",
    "source": [
      "import { useState } from \"react\";",
      "",
      "export function useMaybe(on: boolean) {",
      "  if (on) {",
      "    return useState(0);",
      "  }",
      "  return null;",
      "}"
    ]
  },
  {
    "id": "browser storage in shared behaviour",
    "rule": "no-restricted-globals",
    "plant": "packages/app-logic/src/planted/storage.ts",
    "expect": "refused",
    "source": [
      "export const saved = localStorage.getItem(\"draft\");"
    ]
  },
  {
    "id": "the web framework in shared behaviour",
    "rule": "no-restricted-imports",
    "plant": "packages/app-logic/src/planted/framework.ts",
    "expect": "refused",
    "source": [
      "import Link from \"next/link\";",
      "",
      "export { Link };"
    ]
  },
  {
    "id": "an error caught and dropped",
    "rule": "no-empty",
    "plant": "packages/app/src/planted/swallow.ts",
    "expect": "refused",
    "source": [
      "export function quiet(run: () => void) {",
      "  try {",
      "    run();",
      "  } catch {}",
      "}"
    ]
  },
  {
    "id": "a switched-off type check",
    "rule": "@typescript-eslint/ban-ts-comment",
    "plant": "packages/app/src/planted/ts-comment.ts",
    "expect": "refused",
    "source": [
      "// @ts-ignore",
      "export const count: number = \"one\";"
    ]
  },
  {
    "id": "a lint rule switched off in a file",
    "rule": "ohmail/no-inline-config",
    "plant": "packages/app/src/planted/switch-off.ts",
    "expect": "refused",
    "source": [
      "// eslint-disable-next-line no-empty",
      "export const one = 1;"
    ]
  },
  {
    "id": "a switch-off comment that switches nothing off",
    "rule": "eslint:unused-directive",
    "plant": "packages/core/src/planted/unused-directive.ts",
    "expect": "refused",
    "source": [
      "// eslint-disable-next-line no-empty",
      "export const one = 1;"
    ]
  },
  {
    "id": "a border crossing under a switch-off comment for the next line",
    "rule": "ohmail/package-borders",
    "plant": "packages/core/src/planted/switched-off-next-line.ts",
    "expect": "refused",
    "source": [
      "// eslint-disable-next-line ohmail/package-borders",
      "export { sendMessage } from \"@trafficflow/services\";"
    ]
  },
  {
    "id": "a crossing and a platform's name under a switch-off comment for the whole file",
    "rule": [
      "ohmail/package-borders",
      "ohmail/platform-name"
    ],
    "plant": "packages/core/src/planted/switched-off-file.ts",
    "expect": "refused",
    "source": [
      "/* eslint-disable */",
      "export { sendMessage } from \"@trafficflow/services\";",
      "export const where = process.env.VERCEL_URL;"
    ]
  },
  {
    "id": "a comment that sets the border and platform rules off",
    "rule": "ohmail/no-config-comment",
    "plant": "packages/core/src/planted/rules-set-off.ts",
    "expect": "refused",
    "source": [
      "/* eslint ohmail/platform-name: off, ohmail/package-borders: off */",
      "export { sendMessage } from \"@trafficflow/services\";",
      "export const where = process.env.VERCEL_URL;"
    ]
  },
  {
    "id": "a comment that sets the rule against such comments off",
    "rule": "ohmail/no-config-comment",
    "plant": "packages/core/src/planted/rule-against-comments-set-off.ts",
    "expect": "refused",
    "source": [
      "/* eslint ohmail/no-config-comment: off */",
      "export const one = 1;"
    ]
  },
  {
    "id": "the linter's name in prose and in a string",
    "rule": [
      "ohmail/no-config-comment",
      "eslint:unused-directive"
    ],
    "plant": "packages/core/src/planted/linter-in-prose.ts",
    "expect": "passes",
    "source": [
      "// eslint is a word in this line",
      "/* the eslint configuration is one file */",
      "export const said = \"/* eslint no-var: off */\";"
    ]
  },
  {
    "id": "a literal colour in the kit",
